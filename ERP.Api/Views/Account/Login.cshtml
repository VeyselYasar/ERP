@model LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
}
<section class="auth-layout">
    <aside class="brand-panel">
        <div class="brand-mark">E</div>
        <p class="eyebrow">ERP ÇALIŞMA ALANI</p>
        <h1>İşinizi tek<br />bir yerden yönetin.</h1>
        <p class="brand-copy">ERP çalışma alanınıza güvenli bir şekilde giriş yapın ve kaldığınız yerden devam edin.</p>
        <div class="brand-foot"><span class="status-dot"></span> Güvenli çalışma alanı</div>
    </aside>
    <div class="form-panel">
        <div class="form-wrap">
            <p class="eyebrow mobile-eyebrow">ERP ÇALIŞMA ALANI</p>
            <h2>Tekrar hoş geldiniz</h2>
            <p class="form-intro">Hesabınıza giriş yapmak için bilgilerinizi yazın.</p>
            @if (TempData["Success"] is string success)
            {
                <div class="success-message" role="status">@success</div>
            }
            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
                <div class="field">
                    <label asp-for="Mail"></label>
                    <input asp-for="Mail" autocomplete="email" placeholder="ornek@sirket.com" />
                    <span asp-validation-for="Mail" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" autocomplete="current-password" placeholder="Parolanız" />
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>
                <label class="check-row"><input asp-for="RememberMe" /> <span>Beni hatırla</span></label>
                <button class="primary-button" type="submit">Giriş yap <span aria-hidden="true">→</span></button>
            </form>
            <p class="switch-form">Henüz hesabınız yok mu? <a asp-action="Register">Hesap oluşturun</a></p>
        </div>
    </div>
</section>
